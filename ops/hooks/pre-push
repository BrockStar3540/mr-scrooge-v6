#!/usr/bin/env bash
# ops/hooks/pre-push — THE PIPE GUARD (B-118, Brock: "put a pipe guard so
# that doesn't happen again").
#
# B-111 (2026-07-29) documented that `pytest | tail -1` reports tail's exit
# code, not pytest's — and B-118 (2026-07-31) proved a documented lesson
# without enforcement gets recommitted by its own author. This hook IS the
# enforcement: every push runs the suite UNPIPED and the public-repo secrets
# sweep, and a failure blocks the push at the git layer — no commit chain,
# careless or clever, gets around it.
#
# Install (one-time per clone):   git config core.hooksPath ops/hooks
# Emergency bypass (deliberate, visible, on your head):  git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: running suite (unpiped — the exit code IS the verdict)…"
# CI ALSO runs the suite in RANDOM order (pytest-randomly, requirements-dev).
# If the plugin is missing here the hook silently tests a weaker property than
# CI does — order-dependent breakage passes the guard and fails on GitHub.
# Say so rather than differ quietly.
if ! python3 -c 'import pytest_randomly' 2>/dev/null; then
  echo "pre-push: NOTE pytest-randomly not installed — CI additionally runs the"
  echo "pre-push:      suite in random order. Install requirements-dev.txt for parity."
fi

python3 -m pytest -q -x
echo "pre-push: suite green."

# ── secrets sweep over exactly the commits being pushed ──────────────────────
# VALUE-shaped patterns (split literals so the sweep can't match its own
# source): a secret is an ASSIGNED long token or a real-shaped account id —
# the env-var NAME appears legitimately all over the codebase and docs.
PATTERN="OANDA_API""_TOKEN=[A-Za-z0-9_-]{20,}|ghp""_[A-Za-z0-9]{20,}|github_""pat_[A-Za-z0-9_]{20,}|[0-9]{3}-[0-9]{3}-[0-9]{7}-[0-9]{3}"
PLACEHOLDERS="your-oanda-token|00000000|1234567|xxxxxxx|<[a-z-]*token"
EMPTY_TREE=$(git hash-object -t tree /dev/null)
while read -r local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue  # deletion
    case "$local_ref" in refs/tags/*)
        continue ;;   # a tag points at commits already swept on their branch push
    esac
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        base="$EMPTY_TREE"           # new branch: sweep everything being born
    else
        base="$remote_sha"
    fi
    HITS=$(git diff "$base" "$local_sha" | grep -niE "$PATTERN" | grep -viE "$PLACEHOLDERS" || true)
    if [ -n "$HITS" ]; then
        echo "$HITS" | head -10 >&2
        echo "pre-push: ❌ SECRETS SWEEP HIT in the outgoing diff — push blocked." >&2
        exit 1
    fi
done
echo "pre-push: secrets sweep clean. Push allowed."
